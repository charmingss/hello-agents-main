ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://novel:novel@localhost:5432/novel
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=novel-agent
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_HEALTH_URL=http://localhost:9000/minio/health/live
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=novel
MINIO_SECRET_KEY=novel-local-only
MINIO_BUCKET=novel-sources
MINIO_RECEIPT_SIGNING_KEY=local-receipt-signing-key-change-me
MINIO_RETENTION_VERIFICATION_KEY=local-retention-verify-key-change-me
MINIO_ALLOW_INSECURE_LOCAL=true
QDRANT_HEALTH_URL=http://localhost:6333/healthz
NEO4J_HEALTH_URL=http://localhost:7474/
CORS_ORIGINS=["http://localhost:3000"]
OIDC_ISSUER=http://localhost:8080/realms/novel
OIDC_AUDIENCE=novel-api
# Optional bounded source analysis. Set a model explicitly; no model is selected by default.
ANALYSIS_PROVIDER=deepseek
ANALYSIS_BASE_URL=https://api.deepseek.com
ANALYSIS_MODEL=
ANALYSIS_API_KEY=
ANALYSIS_TIMEOUT_SECONDS=60
